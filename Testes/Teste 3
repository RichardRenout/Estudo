import os
os.system('cls')

pedido = []
nome = []
prato = str(nome)

print('''
                Menu 

  Código        Prato              Valor

    1       Picanha                25,00
    2       Lasanha                20,00
    3       Strogonoff             18,00
    4       Bife Acebolado         15,00
    5       Pão com ovo            5,00     

''')

while True:
    try:
        solicitando = int(input('\nDigite o número do seu pedido: '))
    except ValueError:
        print('Inválido, tente novamente')
        continue

    match solicitando:
        case 1:
            print('\nPicanha')
            print('R$: 25,00')
            nome.append('Picanha: R$25,00')
            pedido.append(25.00) 
        case 2:
            print('\nLasanha')
            print('RS: 20,00')
            nome.append('Lasanha: R$20,00')
            pedido.append(20.00) 
        case 3:
            print('\nStrogonoff')
            print('R$: 18,00')
            nome.append('Strogonoff: R$18,00')
            pedido.append(18.00) 
        case 4:
            print('\nBife Acebolado')
            print('R$: 15,00')
            nome.append('Bife Acebolado: R$15,00')
            pedido.append(15.00) 
        case 5:
            print('\nPão com ovo')
            print('R$: 5,00')
            nome.append('Pão com ovo: R$5,00')
            pedido.append(5.00) 
        case _:
            print('\nInválido, tente novamente')
            continue

    escolha = input('\nDeseja fazer outro pedido? (S ou N): ').lower()

    while True:

        if escolha == 's':
            break
            
        elif escolha == 'n':
            print('\nPedido realizado com Sucesso, aguarde!')
            break

        else:
            print('\nInválido, tente novamente!')
            break

    if escolha == 's':
        continue
    elif escolha == 'n':
        break

valor = sum(pedido)

print(f'O Valor a pagar é: R$ {valor:.2f}')
print(f'O Pedido foi: {nome}')