import os
os.system('cls' if os.name == 'nt' else 'clear')

def cadastrar_funcionario(matriculas, senhas):
    """Cadastra uma nova matrícula e senha nas listas do sistema."""
    print("=== NOVO CADASTRO ===")
    while True:
        nova_matricula = input("Digite a nova matrícula: ").strip()
        if nova_matricula == "":
            print("A matrícula não pode ficar vazia.")
        elif nova_matricula in matriculas:
            print("Essa matrícula já está cadastrada! Tente outra.")
        else:
            break

    while True:
        nova_senha = input("Crie uma senha: ").strip()
        if nova_senha != "":
            break
        print("A senha não pode ficar vazia.")

    matriculas.append(nova_matricula)
    senhas.append(nova_senha)
    print(f"\nMatrícula {nova_matricula} cadastrada com sucesso!")

def autenticar(matricula_digitada, senha_digitada, matriculas, senhas):
    """Verifica se a matrícula existe e se a senha corresponde à mesma posição[cite: 10, 12]."""
    if matricula_digitada in matriculas:
        indice = matriculas.index(matricula_digitada)
        return senhas[indice] == senha_digitada
    return False

def calcular_inss(salario_base):
    """Regra 1: INSS 2026 progressivo (em degraus) com teto de R$ 988,10[cite: 13]."""
    if salario_base >= 8475.55:
        return 988.10

    faixa_1 = 1621.00 * 0.075
    if salario_base <= 1621.00:
        return salario_base * 0.075

    faixa_2 = (2902.84 - 1621.00) * 0.09
    if salario_base <= 2902.84:
        return faixa_1 + ((salario_base - 1621.00) * 0.09)

    faixa_3 = (4354.27 - 2902.84) * 0.12
    if salario_base <= 4354.27:
        return faixa_1 + faixa_2 + ((salario_base - 2902.84) * 0.12)

    faixa_4 = (salario_base - 4354.27) * 0.14
    return faixa_1 + faixa_2 + faixa_3 + faixa_4

def calcular_irrf(salario_base, inss, dependentes):
    """Regra 2 e 2B: IRRF 2026 com base, tabela progressiva e redução[cite: 14, 15]."""
    base = salario_base - inss - (dependentes * 189.59)

    if base <= 2428.80:
        imposto = 0.0
    elif base <= 2826.65:
        imposto = (base * 0.075) - 182.16
    elif base <= 3751.05:
        imposto = (base * 0.15) - 394.16
    elif base <= 4664.68:
        imposto = (base * 0.225) - 675.49
    else:
        imposto = (base * 0.275) - 908.73

    if salario_base <= 5000.00:
        imposto_final = 0.0
    elif salario_base <= 7350.00:
        reducao = 978.62 - (0.133145 * salario_base)
        imposto_final = imposto - reducao
    else:
        imposto_final = imposto

    return max(0.0, imposto_final)

def calcular_vt(salario_base, opcao_vt):
    """Regra 3: Vale-transporte 6% se 's'[cite: 16]."""
    if opcao_vt == "s":
        return salario_base * 0.06
    return 0.0

def calcular_vr(valor_vr):
    """Regra 4: Vale-refeição 20% sobre o valor informado[cite: 16]."""
    return valor_vr * 0.20

def calcular_plano_saude(dependentes):
    """Regra 5: Plano de saúde R$ 150,00 por dependente[cite: 16]."""
    return dependentes * 150.00

def mostrar_contracheque(matricula, salario_base, opcao_vt, valor_vr, inss, irrf, vt, vr, saude, total_descontos, salario_liquido):
    """Etapa 4: Exibe o contracheque formatado na tela[cite: 12, 17]."""
    os.system('cls' if os.name == 'nt' else 'clear')
    vt_texto = "Sim" if opcao_vt == "s" else "Não"

    print("=" * 48)
    print(f"CONTRACHEQUE · MATRÍCULA {matricula}")
    print("=" * 48)
    print(f"Benefícios: VT ({vt_texto}) | VR (R$ {valor_vr:.2f})")
    print("-" * 48)
    print(f"{'Salário base':<30} R$ {salario_base:>12.2f}")
    print("-" * 48)
    print(f"{'(-) INSS':<30} R$ {inss:>12.2f}")
    print(f"{'(-) IRRF':<30} R$ {irrf:>12.2f}")
    print(f"{'(-) Vale-transporte':<30} R$ {vt:>12.2f}")
    print(f"{'(-) Vale-refeição':<30} R$ {vr:>12.2f}")
    print(f"{'(-) Plano de saúde':<30} R$ {saude:>12.2f}")
    print("-" * 48)
    print(f"{'Total de descontos':<30} R$ {total_descontos:>12.2f}")
    print("=" * 48)
    print(f"{'SALÁRIO LÍQUIDO':<30} R$ {salario_liquido:>12.2f}")
    print("=" * 48)

def processar_folha_pagamento(matricula):
    """Executa as etapas 2, 3 e 4 para o funcionário logado[cite: 9]."""
    os.system('cls' if os.name == 'nt' else 'clear')
    print(f"Acesso liberado! Bem-vindo(a), matrícula {matricula}.\n")

    while True:
        salario_base = float(input("Salário base (R$): "))
        if salario_base > 0:
            break
        print("O salário deve ser maior que zero.")

    while True:
        opcao_vt = input("Deseja vale-transporte? (s/n): ").strip().lower()
        if opcao_vt in ["s", "n"]:
            break
        print("Digite apenas 's' ou 'n'.")

    while True:
        valor_vr = float(input("Valor do vale-refeição (R$): "))
        if valor_vr >= 0:
            break
        print("O valor não pode ser negativo.")

    while True:
        dependentes = int(input("Quantidade de dependentes: "))
        if dependentes >= 0:
            break
        print("A quantidade não pode ser negativa.")

    inss = calcular_inss(salario_base)
    irrf = calcular_irrf(salario_base, inss, dependentes)
    vt = calcular_vt(salario_base, opcao_vt)
    vr = calcular_vr(valor_vr)
    saude = calcular_plano_saude(dependentes)

    total_descontos = inss + irrf + vt + vr + saude
    salario_liquido = salario_base - total_descontos

    mostrar_contracheque(matricula, salario_base, opcao_vt, valor_vr,
        inss, irrf, vt, vr, saude, total_descontos, salario_liquido)

def main():
    matriculas_cadastradas = ["1001"]
    senhas_cadastradas = ["1234"]

    while True:
        print("\n=== SISTEMA RH · MENU PRINCIPAL ===")
        print("1 - Matricular (Cadastrar)")
        print("2 - Fazer Login")
        print("3 - Sair")

        opcao = input("\nEscolha uma opção: ").strip()
        os.system('cls' if os.name == 'nt' else 'clear')

        if opcao == "1":
            cadastrar_funcionario(matriculas_cadastradas, senhas_cadastradas)

        elif opcao == "2":
            tentativas = 0
            acesso_liberado = False

            while tentativas < 3:
                print("=== LOGIN DO FUNCIONÁRIO ===")
                matricula = input("Matrícula: ").strip()
                senha = input("Senha: ").strip()

                if autenticar(matricula, senha, matriculas_cadastradas, senhas_cadastradas):
                    acesso_liberado = True
                    break

                tentativas += 1
                os.system('cls' if os.name == 'nt' else 'clear')
                print(f"Matrícula ou senha incorretas! Tentativas restantes: {3 - tentativas}\n")

            if acesso_liberado:
                processar_folha_pagamento(matricula)
                input("\nPressione ENTER para voltar ao menu...")
                os.system('cls' if os.name == 'nt' else 'clear')
            else:
                print("Número máximo de tentativas excedido. Voltando ao menu...\n")

        elif opcao == "3":
            print("Encerrando o sistema. Até logo!")
            break

        else:
            print("Opção inválida! Escolha 1, 2 ou 3.")

if __name__ == "__main__":
    main()